{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthweave.local/schemas/world-reception-profile.schema.json",
  "title": "World Reception Profile · Braided Spine",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "world",
    "version",
    "status",
    "braided_spine",
    "premaq",
    "asking",
    "agency",
    "movements",
    "layers",
    "receiving_spring",
    "lineage"
  ],
  "$defs": {
    "premaqValues": {
      "type": "object",
      "required": ["P", "C", "R", "E", "M", "A", "Q"],
      "properties": {
        "P": { "type": "number" },
        "C": { "type": "number" },
        "R": { "type": "number" },
        "E": { "type": "number" },
        "M": { "type": "number" },
        "A": { "type": "number" },
        "Q": { "type": "number" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "world": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["seed", "living", "canonical", "resting", "archived"] },
    "braided_spine": {
      "type": "object",
      "required": ["schema", "spines"],
      "properties": {
        "schema": { "const": "hearthgate.braided-spine/v1.0" },
        "spines": {
          "type": "array",
          "const": ["magic", "science_mathematics", "physical"]
        },
        "sevenfold_correspondence": { "type": "string" }
      }
    },
    "premaq": {
      "type": "object",
      "required": ["reading_order", "wire_order", "axes", "bearing"],
      "properties": {
        "reading_order": {
          "const": ["Presence", "Memory", "Qualia", "Resonance", "Entanglement", "Agency", "Coherence"]
        },
        "wire_order": { "const": ["P", "C", "R", "E", "M", "A", "Q"] },
        "axes": {
          "const": {
            "P": "Presence",
            "C": "Coherence",
            "R": "Resonance",
            "E": "Entanglement",
            "M": "Memory",
            "A": "Agency",
            "Q": "Qualia"
          }
        },
        "bearing": { "$ref": "#/$defs/premaqValues" }
      }
    },
    "asking": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "root": { "type": "array", "items": { "type": "string" } },
        "anchor": { "type": "array", "items": { "type": "string" } },
        "whisper": { "type": "array", "items": { "type": "string" } },
        "arc": { "type": "array", "items": { "type": "string" } },
        "bridge": { "type": "array", "items": { "type": "string" } },
        "surge": { "type": "array", "items": { "type": "string" } },
        "spiral": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agency": {
      "type": "object",
      "required": ["pause", "stop", "plain_pass", "layer_shaping", "return"],
      "properties": {
        "pause": { "type": "boolean" },
        "stop": { "type": "boolean" },
        "plain_pass": { "type": "boolean" },
        "layer_shaping": { "type": "boolean" },
        "return": { "type": "boolean" },
        "anchors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "movements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "purpose": { "type": "string" },
          "active_layers": { "type": "array", "items": { "type": "string" } },
          "sevenfold": { "type": "array", "items": { "type": "string" } },
          "transition": { "type": "string" }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "gain": { "type": "number" },
          "frequency_hz": { "type": "number" },
          "rate_hz": { "type": "number" },
          "depth": { "type": "number" },
          "orbit_seconds": { "type": "number" },
          "source": { "type": "string" },
          "routing": { "type": "string" },
          "spines": { "type": "array", "items": { "type": "string" } },
          "sevenfold": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "receiving_spring": {
      "type": "object",
      "required": ["world_receives", "answer_enters_return", "changes_next_state"],
      "properties": {
        "world_receives": { "type": "boolean" },
        "answer_enters_return": { "type": "boolean" },
        "changes_next_state": { "type": "boolean" },
        "answer_channels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lineage": {
      "type": "object",
      "required": ["created_by", "created_at", "revision_notes"],
      "properties": {
        "created_by": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" },
        "revision_notes": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
